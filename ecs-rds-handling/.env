# ----------------------------------------------------
# 1. DATABASE CONFIGURATION
# ----------------------------------------------------
# The name of the database where the table will be created/imported.
DB_NAME=<Your_Database_Name_e.g._student_data>

# MySQL Connection Details
MYSQL_HOST=<Your_MySQL_Host_or_IP_e.g._localhost_or_127.0.0.1>
MYSQL_USER=<Your_MySQL_Username_e.g._root>
MYSQL_PASSWORD=<Your_Secure_MySQL_Password>


# ----------------------------------------------------
# 2. OBJECT STORAGE (OBS) CONFIGURATION
# ----------------------------------------------------
# Credentials for accessing the OBS service
OBS_ACCESS_KEY_ID=<Your_OBS_Access_Key_ID>
OBS_SECRET_ACCESS_KEY=<Your_OBS_Secret_Access_Key>

# Endpoint/Server URL for the OBS service
OBS_SERVER=<Your_OBS_Server_Endpoint_e.g._obs.eu-west-0.cloud.com>

# Location of the CSV file
OBS_BUCKET=<Your_OBS_Bucket_Name_e.g._student-analytics-bucket>
OBS_KEY=<The_full_path_to_the_CSV_file_in_the_bucket_e.g._data/students_churn.csv>